# Copy to the repo root as `.env`, then `docker compose up -d --build`.
#
#   cp docker/.env.example .env
#
# Every value here has a working default in `docker-compose.yml`, so the stack
# comes up with no .env at all. This file exists for the two things people
# actually need to change — a port that is already taken, and the database
# password — and to make the defaults visible rather than buried in YAML.
#
# NONE OF THESE ARE SECRETS. They are local-development values, committed on
# purpose. A real deployment reads its own from /etc/timebank-backend.env and
# must not reuse anything here.

# ── Ports ────────────────────────────────────────────────────────────────────
# 3307, not 3306: a machine with MySQL already installed has 3306 bound, and
# the resulting failure looks like a broken container rather than a port clash.
TIMEBANK_DB_HOST_PORT=3307
# 28080, not 8080: 8080 is the most contended port on a dev machine and a
# clash here is silent — the stack comes up healthy and the host reaches
# whatever else is listening.
TIMEBANK_BACKEND_PORT=28080

# ── Database ─────────────────────────────────────────────────────────────────
TIMEBANK_DB_NAME=timebank
TIMEBANK_DB_USERNAME=timebank_app
TIMEBANK_DB_PASSWORD=timebank-not-for-production
MYSQL_ROOT_PASSWORD=root-not-for-production

# ── Backend ──────────────────────────────────────────────────────────────────
# The frontend dev server's origin. CORS rejects anything not listed here, and
# the rejection is a 403 with no clue in the browser console about this setting
# (issue 027), so change it here rather than guessing later.
TIMEBANK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:28080

# Printed on activation slips and used to build their QR deep links (plan 10
# §2.9). Locally it should point at wherever you open the app — the dev server.
TIMEBANK_SITE_ROOT_URL=http://localhost:5173

# Signs short-lived evidence download links. Any non-empty string works locally.
TIMEBANK_FILE_TOKEN_SECRET=local-development-only-not-a-secret

TIMEBANK_ENVIRONMENT=local
