# Copy to .env.local (git-ignored) before running `pnpm dev`. There is no
# mock mode — every api.* call always hits the real backend — so this is
# required, not optional; vite.config.ts fails fast at startup if it's
# missing. See frontend/README.md.

# Vite dev-server proxy target for /api/* — avoids CORS/cookie-SameSite
# issues a direct cross-origin fetch would hit. No trailing slash.
# The value below is a placeholder — put the real test-server URL (see the
# untracked test-server-credits.md) in your own .env.local, not here.
VITE_DEV_PROXY_TARGET=https://tb.example.com
