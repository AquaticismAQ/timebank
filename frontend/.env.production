# Loaded automatically by `vite build` (Vite's mode-specific env file
# convention — see .env.example for the dev-only counterpart). Committed,
# not git-ignored: nothing here is a secret, just which api.* domains a
# production build should call for real instead of mock.
#
# A production deployment must talk to the real backend for every domain —
# unlike a local `pnpm dev` (still full-mock by default, see api/config.ts),
# there is no "demo mode" build. VITE_DEV_PROXY_TARGET is deliberately not
# set here: production serves the frontend from the same origin as the
# backend (nginx reverse-proxies /api/* — see frontend/README.md), so
# fetch('/api/...') already resolves correctly with no dev-proxy involved.
VITE_API_REAL_DOMAINS=accounts,applications,auth,cases,dashboards,eventProposals,exports,files,imports,notifications,organizations,projects,reports,reviewQueue,rules,school,serviceRecords,students,users
